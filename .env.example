# Onshape API Credentials
# Create these at https://cad.onshape.com/appstore/dev-portal
ONSHAPE_ACCESS_KEY=your_onshape_access_key_here
ONSHAPE_SECRET_KEY=your_onshape_secret_key_here
ONSHAPE_BASE_URL=https://cad.onshape.com

# Backend API Configuration
# In local development, the frontend proxies /api to http://localhost:8787
# In production, set this to your Cloudflare Worker URL or leave empty if served on same domain
VITE_API_URL=http://localhost:8787

# Worker Mock Fallback Mode: Set to 'true' to force procedural mock generation without hitting Onshape
# Defaults to auto: uses live Onshape if credentials are provided, otherwise falls back to mock.
MOCK_MODE=auto
