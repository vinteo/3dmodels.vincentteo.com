{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "3dmodels-backend",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "ONSHAPE_BASE_URL": "https://cad.onshape.com",
    "MOCK_MODE": "auto"
  }
}
